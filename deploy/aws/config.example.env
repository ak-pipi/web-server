# Copy this file to web_server/web-server/deploy/aws/config.env. It is intentionally ignored by Git.
# The AWS profile must already be authenticated (for example: aws sso login).
AWS_PROFILE=default
AWS_REGION=ap-east-1
STACK_NAME=NiuMaCostSaver
# Optional deployment guardrails. When set, both deployment scripts refuse to
# continue unless the active AWS CLI identity matches this account and role.
EXPECTED_AWS_ACCOUNT_ID=
EXPECTED_DEPLOY_ROLE=

# Public DNS names. Point their A records at the two Elastic IPs printed by
# deploy-infra.sh before running publish.sh, so Let's Encrypt can validate them.
API_DOMAIN=api.example.com
GAME_DOMAIN=game.example.com
# Optional. If empty, Certbot uses --register-unsafely-without-email; TLS still
# works, but you will not receive certificate expiry/recovery notifications.
TLS_EMAIL=

# Cocos Web client. The first infrastructure deployment can leave the
# certificate and hosted-zone values empty; CloudFront will expose its default
# https://*.cloudfront.net address. To use WEB_DOMAIN, request/validate the ACM
# certificate in us-east-1 first, then rerun deploy-infra.sh.
WEB_DOMAIN=play.api.example.com
WEB_CERTIFICATE_ARN=
# Leave these empty when DNS is not hosted in Route 53. Otherwise CDK creates
# A/AAAA Alias records automatically.
WEB_HOSTED_ZONE_ID=
WEB_HOSTED_ZONE_NAME=api.example.com
# Adjust this path if Cocos Creator was installed elsewhere.
COCOS_CREATOR_BIN=/Applications/CocosCreator/Creator/3.8.7/CocosCreator.app/Contents/MacOS/CocosCreator
# Optional: use a pre-built directory instead of invoking Cocos Creator.
WEB_BUILD_DIR=
SKIP_COCOS_BUILD=0

# web_ui admin console. The first infrastructure deployment can leave the
# certificate and hosted-zone values empty; CloudFront will expose its default
# https://*.cloudfront.net address. To use WEB_UI_DOMAIN, request/validate the
# ACM certificate in us-east-1 first, then rerun deploy-infra.sh.
WEB_UI_DOMAIN=admin.api.example.com
WEB_UI_CERTIFICATE_ARN=
WEB_UI_HOSTED_ZONE_ID=
WEB_UI_HOSTED_ZONE_NAME=api.example.com
# Keep these in sync with web_ui/vue.config.js and .env.production unless you
# intentionally change the frontend routing convention.
WEB_UI_STATIC_PREFIX=niuma66-ui
WEB_UI_API_PREFIX=/niuma66
WEB_UI_BUILD_DIR=
SKIP_WEB_UI_BUILD=0

# Keep 0 except when creating a brand-new, empty RDS database. Setting this to
# 1 imports sql/niuma.sql and the explicit migration list in scripts/publish.sh;
# the base dump drops tables and must only be used for a brand-new empty RDS.
INITIALIZE_DATABASE=0
# Optional destructive reset. Only set to 1 together with INITIALIZE_DATABASE=1
# after confirming v12_reset_players_for_new_rules.sql is required.
RESET_PLAYER_DATA=0

# Source path overrides. By default these are resolved from this web_server
# project to sibling workspace directories.
GAME_SERVER_DIR=
SQL_DIR=
CLIENT_DIR=
WEB_UI_DIR=

# Optional safeguards/tuning.
SKIP_DNS_CHECK=0
GAME_INSTANCE_TYPE=t3.medium
# auto: local linux/amd64 Docker build when supported, otherwise build on the
# x86_64 Game EC2 through SSM. Set 0 to force local, 1 to force remote.
REMOTE_GAME_BUILD=auto
