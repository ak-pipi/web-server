<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.niuma.admin.mapper.GameRecordRetentionMapper">

    <delete id="deleteExpiredGameReplaysByRound">
        delete `t1`
        from `game_replay` `t1`
        inner join `game_round` `t2` on `t1`.`round_id` = `t2`.`id`
        where coalesce(`t2`.`settled_at`, `t2`.`create_time`) <![CDATA[<]]> #{cutoff}
    </delete>

    <delete id="deleteExpiredGameReplays">
        delete from `game_replay`
        where `create_time` <![CDATA[<]]> #{cutoff}
    </delete>

    <delete id="deleteExpiredGameRounds">
        delete from `game_round`
        where coalesce(`settled_at`, `create_time`) <![CDATA[<]]> #{cutoff}
    </delete>

    <delete id="deleteExpiredMahjongRecords">
        delete from `game_mahjong_record`
        where `time` <![CDATA[<]]> #{cutoff}
    </delete>

