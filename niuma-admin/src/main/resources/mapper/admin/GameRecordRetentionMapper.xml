    </delete>

    <delete id="deleteExpiredLackeyRoundPlayers">
        delete `t1`
        from `game_lackey_round_player` `t1`
        inner join `game_lackey_round` `t2` on `t1`.`round_id` = `t2`.`id`
        where `t2`.`time` <![CDATA[<]]> #{cutoff}
    </delete>

    <delete id="deleteExpiredLackeyRounds">
        delete from `game_lackey_round`
        where `time` <![CDATA[<]]> #{cutoff}
    </delete>
</mapper>
