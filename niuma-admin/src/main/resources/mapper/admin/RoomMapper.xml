<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.niuma.admin.mapper.RoomMapper">
    <select id="getGameType" resultType="Integer">
        SELECT `game_type` FROM `room` WHERE `id` = #{id}
    </select>

    <select id="getDistrictId" resultType="Integer">
        SELECT `district_id` FROM `room` WHERE `id` = #{id}
    </select>

    <select id="listByGameId" resultType="com.niuma.admin.entity.Room">
        SELECT * FROM `room`
        WHERE `game_id` = #{gameId}
        ORDER BY `create_time` DESC
    </select>

    <select id="listByStatus" resultType="com.niuma.admin.entity.Room">
        SELECT * FROM `room`
        WHERE `status` = #{status}
        ORDER BY `create_time` DESC
    </select>

    <select id="listByOwnerId" resultType="com.niuma.admin.entity.Room">
        SELECT * FROM `room`
        WHERE `owner_id` = #{ownerId}
        ORDER BY `create_time` DESC
    </select>
</mapper>
